# Copie para .env.local e ajuste. Nunca faça commit de .env.local.

# Desenvolvimento: Postgres local do docker-compose.yml.
DATABASE_URL=postgres://observa:observa@localhost:54329/observa

# Produção (Supabase): painel do projeto > botão "Connect" > "Session pooler".
# Troque [SENHA] pela senha do banco e mantenha ?sslmode=require (TLS é obrigatório fora do localhost).
# DATABASE_URL=postgresql://postgres.[ID-DO-PROJETO]:[SENHA]@[HOST-DO-POOLER]:5432/postgres?sslmode=require
